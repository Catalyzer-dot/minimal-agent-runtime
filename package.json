{
  "name": "minimal-agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "node --experimental-strip-types examples/calculator.ts",
    "demo:deepseek": "node --env-file-if-exists=.env --experimental-strip-types examples/deepseek-calculator.ts",
    "demo:deepseek:stream": "node --env-file-if-exists=.env --experimental-strip-types examples/deepseek-streaming.ts",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
